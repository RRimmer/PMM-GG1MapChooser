					<Button id="mv-close" class="mv-x"><Label class="stratum-bold-tf" text="×" /></Button>
				</Panel>
				<Panel class="mv-tbar" hittest="false"><Panel id="mv-tfill" class="mv-tfill t20" hittest="false" /></Panel>
				<Panel class="mv-rows">
