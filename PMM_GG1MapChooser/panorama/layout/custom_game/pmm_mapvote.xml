					<Panel class="mv-info" hittest="false">
						<Panel class="mv-line" hittest="false">
							<Label class="mv-name stratum-bold-tf" text="{s:name0}" />
							<Label id="mv-badge-0" class="mv-badge stratum-bold-tf" text="{s:badge0}" />
							<Label class="mv-mine stratum-bold-tf" text="{s:mv_yours}" />
						</Panel>
						<Panel class="mv-bar" hittest="false"><Panel id="mv-fill-0" class="mv-fill v0" hittest="false" /></Panel>
					</Panel>
					<Label class="mv-cnt stratum-bold-tf" text="{s:cnt0}" />
					<Panel class="mv-tick" hittest="false" />
				</Button>
